---
import type { HTMLAttributes } from 'astro/types';
import { tv } from 'tailwind-variants';

interface Props extends Omit<
  HTMLAttributes<'div'>,
  'id' | 'role' | 'tabindex' | 'hidden'
> {
  value: string;
  default?: boolean;
}

export const tabsContent = tv({
  base: 'mt-6 focus-visible:outline-2 focus-visible:outline-offset-2',
});

const { value, default: isDefault, class: className, ...rest } = Astro.props;
---

<div
  class={tabsContent({ class: className })}
  data-slot="tabs-content"
  data-tabs-content
  data-value={value}
  data-state={isDefault ? 'active' : 'inactive'}
  role="tabpanel"
  tabindex="0"
  {...!isDefault && { hidden: true }}
  {...rest}
>
  <slot />
</div>
