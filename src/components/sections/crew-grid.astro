---
import type { Person } from '@lib/types';
import { formatAgeDisplay, getImageUrl } from '@lib/utils';

interface Props {
  title: string;
  people: Person[];
}

const { title, people } = Astro.props;
---

{
  people.length > 0 && (
    <div>
      <h2 class="text-sm font-medium text-muted-foreground mb-3">{title}</h2>
      <div class="section-search-grid grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-3">
        {people.map((person) => (
          <a
            href={`/people/${person.id}`}
            class="group flex items-center gap-3 p-2 rounded-lg border border-border bg-card hover:bg-accent/50 transition-colors"
          >
            <div class="h-16 w-16 shrink-0 overflow-hidden rounded-lg bg-muted">
              {person.photoPath ? (
                <img
                  src={getImageUrl(person.photoPath, 'w185')}
                  alt={person.name}
                  class="h-full w-full object-cover"
                  loading="lazy"
                />
              ) : (
                <div class="flex h-full w-full items-center justify-center text-xs font-semibold text-muted-foreground">
                  {person.name.charAt(0)}
                </div>
              )}
            </div>
            <div class="min-w-0 flex-1">
              <p class="font-medium text-sm truncate group-hover:text-amber-500 transition-colors">
                {person.name}
              </p>
              {person.role && (
                <p class="text-xs text-muted-foreground truncate">
                  {person.role}
                </p>
              )}
              {formatAgeDisplay(person) && (
                <p class="text-xs text-muted-foreground/70">
                  {formatAgeDisplay(person)}
                </p>
              )}
            </div>
          </a>
        ))}
      </div>
    </div>
  )
}
