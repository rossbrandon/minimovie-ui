---
import { PersonCard } from '@components/cards';
import type { Person } from '@lib/types';

interface Props {
  cast: Person[];
  seriesId?: number;
  limit?: number;
}

const { cast, seriesId, limit = 16 } = Astro.props;

const topCast = cast.slice(0, limit);
---

{
  topCast.length > 0 && (
    <div class="grid grid-cols-1 sm:grid-cols-[repeat(auto-fill,minmax(120px,1fr))] gap-3 sm:gap-6 pt-1">
      {topCast.map((person) => (
        <PersonCard
          id={person.id}
          name={person.name}
          photoPath={person.photoPath}
          role={person.role}
          episodeCount={person.episodeCount}
          episodeCountHref={
            seriesId && person.episodeCount
              ? `/series/${seriesId}/person/${person.id}`
              : undefined
          }
          birthday={person.birthday}
          deathday={person.deathday}
          ageAtRelease={person.ageAtRelease}
          currentAge={person.currentAge}
          ageRange={person.ageRange}
          prefetch={true}
        />
      ))}
    </div>
  )
}
