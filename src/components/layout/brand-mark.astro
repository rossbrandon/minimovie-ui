---
import { IconMovie } from '@components/icons';

interface Props {
  as?: 'h1' | 'h2';
  class?: string;
  [attr: `data-${string}`]: string | boolean | undefined;
}

const { as: Tag = 'h1', class: className, ...rest }: Props = Astro.props;
---

<div class:list={['space-y-3', className]} {...rest}>
  <div class="flex items-center justify-center gap-3">
    <IconMovie class="h-10 w-10 text-amber-500" />
    <Tag class="text-4xl md:text-5xl font-bold tracking-tight">MiniMovie</Tag>
  </div>
  <p class="text-muted-foreground text-lg">
    Minimal, yet interesting film database
  </p>
</div>
