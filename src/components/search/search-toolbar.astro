---
import { IconX } from '@components/icons';

interface Props {
  inputId?: string;
  inputName?: string;
  placeholder?: string;
  ariaLabel?: string;
  value?: string;
  class?: string;
}

const {
  inputId,
  inputName = 'q',
  placeholder = 'Search...',
  ariaLabel = 'Search',
  value = '',
  class: className = '',
} = Astro.props;
---

<div
  class:list={[
    'flex min-h-12 w-full items-center gap-2 border-b border-border bg-background/95 backdrop-blur px-2 py-1',
    className,
  ]}
>
  <slot name="left" />
  <form action="/search" method="GET" class="flex-1 min-w-0">
    <label for={inputId} class="sr-only">{ariaLabel}</label>
    <input
      type="search"
      id={inputId}
      name={inputName}
      placeholder={placeholder}
      value={value}
      class="w-full h-9 bg-transparent border-0 outline-none focus:ring-0 focus-visible:ring-0 text-foreground placeholder:text-muted-foreground text-base"
      data-search-input
      autocomplete="off"
      enterkeyhint="search"
    />
  </form>
  <button
    type="button"
    class="hidden shrink-0 h-9 w-9 items-center justify-center rounded-md text-muted-foreground hover:bg-accent hover:text-foreground"
    data-search-clear
    aria-label="Clear search"
  >
    <IconX class="h-5 w-5" />
  </button>
  <slot name="right" />
</div>

<style>
  input[type='search']::-webkit-search-cancel-button,
  input[type='search']::-webkit-search-decoration {
    -webkit-appearance: none;
    appearance: none;
  }
</style>
