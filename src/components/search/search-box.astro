---
import { IconSearch } from '@components/icons';
import { Kbd } from '@components/starwind/kbd';

interface Props {
  placeholder?: string;
  value?: string;
  variant?: 'hero' | 'header';
  showKeyboardHint?: boolean;
  autofocus?: boolean;
}

const {
  placeholder = 'Search...',
  value = '',
  variant = 'header',
  showKeyboardHint = false,
  autofocus = false,
} = Astro.props;

const isHero = variant === 'hero';
const dropdownMaxHeight = isHero ? 'max-h-80' : 'max-h-72';
---

<search-box
  class="relative w-full"
  data-variant={variant}
  data-autofocus={autofocus ? '' : null}
>
  <form action="/search" method="GET" class="w-full">
    {
      isHero ? (
        <div class="relative">
          <div class="flex items-center gap-0 bg-white/10 dark:bg-white/5 backdrop-blur-xl border border-white/20 dark:border-white/10 rounded-xl p-1.5 shadow-lg ring-1 ring-black/5 dark:ring-white/5">
            <IconSearch class="ml-3 h-5 w-5 text-muted-foreground shrink-0" />
            <input
              type="search"
              name="q"
              placeholder={placeholder}
              value={value}
              class="flex-1 bg-transparent border-0 outline-none px-3 py-2 text-base sm:text-lg text-foreground placeholder:text-muted-foreground focus:ring-0 focus:outline-none"
              data-search-input
              autocomplete="off"
              enterkeyhint="search"
            />
            <button
              type="submit"
              class="px-4 sm:px-6 py-2 sm:py-2.5 bg-amber-500 hover:bg-amber-400 text-black font-medium rounded-lg transition-all shrink-0 text-sm sm:text-base"
            >
              Search
            </button>
          </div>
          <div
            class={`absolute top-full left-0 right-0 z-50 mt-2 hidden sm:block rounded-lg border border-border bg-popover shadow-lg opacity-0 invisible transition-opacity duration-150 text-left ${dropdownMaxHeight}`}
            data-dropdown
          >
            <div class="overflow-y-auto max-h-[inherit] p-1" data-results />
            <div
              class="hidden p-4 text-center text-sm text-muted-foreground"
              data-empty
            >
              No results found
            </div>
            <div class="hidden p-4" data-loading>
              <div class="space-y-2">
                <div class="flex items-center gap-3">
                  <div class="h-12 w-9 rounded bg-muted animate-pulse shrink-0" />
                  <div class="flex-1 space-y-1.5">
                    <div class="h-4 w-3/4 rounded bg-muted animate-pulse" />
                    <div class="h-3 w-1/4 rounded bg-muted animate-pulse" />
                  </div>
                </div>
                <div class="flex items-center gap-3">
                  <div class="h-12 w-9 rounded bg-muted animate-pulse shrink-0" />
                  <div class="flex-1 space-y-1.5">
                    <div class="h-4 w-2/3 rounded bg-muted animate-pulse" />
                    <div class="h-3 w-1/3 rounded bg-muted animate-pulse" />
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      ) : (
        <div class="relative w-full max-w-xl md:max-w-2xl lg:max-w-3xl xl:max-w-4xl mx-auto">
          <IconSearch class="absolute left-3 top-1/2 h-5 w-5 -translate-y-1/2 text-muted-foreground pointer-events-none" />
          <input
            type="search"
            name="q"
            placeholder={placeholder}
            value={value}
            class:list={[
              'w-full bg-transparent border-0 outline-none text-foreground',
              'focus:ring-0 focus-visible:ring-0 focus:outline-none',
              'placeholder:text-muted-foreground',
              'disabled:cursor-not-allowed disabled:opacity-50',
              'h-14 pl-10 pr-16 text-base',
            ]}
            data-search-input
            autocomplete="off"
            enterkeyhint="search"
          />
          {showKeyboardHint && (
            <div class="absolute right-2 top-1/2 -translate-y-1/2 hidden sm:flex items-center gap-0.5 pointer-events-none">
              <Kbd data-modifier-key>Ctrl</Kbd>
              <Kbd>K</Kbd>
            </div>
          )}
          <div
            class={`absolute top-full left-0 right-0 z-50 mt-2 hidden sm:block rounded-lg border border-border bg-popover shadow-lg opacity-0 invisible transition-opacity duration-150 ${dropdownMaxHeight}`}
            data-dropdown
          >
            <div class="overflow-y-auto max-h-[inherit] p-1" data-results />
            <div
              class="hidden p-4 text-center text-sm text-muted-foreground"
              data-empty
            >
              No results found
            </div>
            <div class="hidden p-4" data-loading>
              <div class="space-y-2">
                <div class="flex items-center gap-3">
                  <div class="h-12 w-9 rounded bg-muted animate-pulse shrink-0" />
                  <div class="flex-1 space-y-1.5">
                    <div class="h-4 w-3/4 rounded bg-muted animate-pulse" />
                    <div class="h-3 w-1/4 rounded bg-muted animate-pulse" />
                  </div>
                </div>
                <div class="flex items-center gap-3">
                  <div class="h-12 w-9 rounded bg-muted animate-pulse shrink-0" />
                  <div class="flex-1 space-y-1.5">
                    <div class="h-4 w-2/3 rounded bg-muted animate-pulse" />
                    <div class="h-3 w-1/3 rounded bg-muted animate-pulse" />
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      )
    }
  </form>
</search-box>

<script>
  import '@components/search/search-box.client';
</script>
