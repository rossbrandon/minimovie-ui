---
import { IconVideoOff } from '@components/icons';

interface Props {
  title?: string;
  message?: string;
}

const {
  title = 'Media not found',
  message = "The page you're looking for does not exist or has been moved.",
} = Astro.props;
---

<div class="min-h-[60vh] flex flex-col items-center justify-center text-center">
  <IconVideoOff class="w-32 h-auto mx-auto mb-6 text-amber-500" />
  <h1 class="text-2xl font-semibold mb-2">{title}</h1>
  <p class="text-muted-foreground mb-6">{message}</p>
  <a
    href="/"
    class="px-6 py-2.5 bg-amber-500 hover:bg-amber-400 text-black font-medium rounded-lg transition-all text-sm sm:text-base"
    >Find Something Else</a
  >
</div>
