---
import { Button } from '@components/starwind/button';

import UserMenu from './UserMenu.astro';

const user = Astro.locals.user;
const unseenCount = Astro.locals.unseenAchievementCount ?? 0;
---

<span data-auth-state data-unseen-achievements={unseenCount > 0 ? String(unseenCount) : undefined}>
  {
    user ? (
      <UserMenu avatarUrl={user.avatarUrl} givenName={user.givenName} />
    ) : (
      <Button href="/login" variant="ghost" size="sm">
        Sign in
      </Button>
    )
  }
</span>
