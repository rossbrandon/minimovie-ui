---
import {
  Avatar,
  AvatarFallback,
  AvatarImage,
} from '@components/starwind/avatar';

interface Props {
  avatarUrl: string | null;
  givenName: string | null;
  size?: 'sm' | 'md' | 'lg';
  class?: string;
}

const {
  avatarUrl,
  givenName,
  size = 'sm',
  class: className = '',
} = Astro.props;
const initial = givenName?.charAt(0).toUpperCase() || '?';
---

<Avatar size={size} class={className}>
  {
    avatarUrl && (
      <AvatarImage
        src={avatarUrl}
        alt={givenName || 'User avatar'}
        referrerpolicy="no-referrer"
      />
    )
  }
  <AvatarFallback class="bg-amber-500 text-white">
    {initial}
  </AvatarFallback>
</Avatar>
