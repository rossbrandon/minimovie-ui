---
import { SignInToTrack } from '@components/user';

import MediaToolbar from './media-toolbar';

interface Props {
  mediaType: 'movie' | 'series' | 'episode' | 'season';
  mediaId: number;
  seriesId?: number;
  seasonNumber?: number;
  episodeNumber?: number;
}

const props = Astro.props;
---

{
  /*
    The anon-only and authed-only classes indicate the presence of the authenticated
    user marker cookie: mm_authed. The pre-paint script in Layout.astro checks for this
    cookie and adds `.authed` to <html> and allows CSS to show the appropriate container
    and allow for efficient page HTML caching as well as dynamic user content via SolidJS
    client islands.
  */
}
<div>
  <span class="anon-only">
    <SignInToTrack />
  </span>
  <span class="authed-only">
    <span
      class="media-toolbar-shell relative inline-flex h-11 w-22 justify-end align-top"
    >
      <span
        class="media-toolbar-skeleton bg-muted/50 absolute inset-0 rounded-md"
        aria-hidden="true"></span>
      <MediaToolbar
        client:only="solid-js"
        mediaType={props.mediaType}
        mediaId={props.mediaId}
        seriesId={props.seriesId}
        seasonNumber={props.seasonNumber}
        episodeNumber={props.episodeNumber}
      />
    </span>
  </span>
</div>

<style>
  .media-toolbar-shell:has(button) .media-toolbar-skeleton {
    display: none;
  }
</style>
