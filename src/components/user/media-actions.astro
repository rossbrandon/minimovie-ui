---
import {
  IconBookmark,
  IconBookmarkFilled,
  IconEye,
  IconEyeCheck,
} from '@components/icons';
import { Button } from '@components/starwind/button';
import {
  ButtonGroup,
  ButtonGroupSeparator,
} from '@components/starwind/button-group';
import { fetchUserAPI } from '@lib/api';
import { getSessionCookie } from '@lib/session';

interface Props {
  mediaType: 'movie' | 'series' | 'episode' | 'season';
  mediaId: number;
  seriesId?: number;
  seasonNumber?: number;
  episodeNumber?: number;
}

const { mediaType, mediaId, seriesId, seasonNumber, episodeNumber } =
  Astro.props;

const user = Astro.locals.user;
const showWatchlist = mediaType === 'movie' || mediaType === 'series';

let inWatchlist = false;
let watchlistItemId: string | null = null;
let hasWatched = false;
let watchEventId: string | null = null;

if (user) {
  const sessionCookie = getSessionCookie(Astro.cookies)!;

  if (showWatchlist) {
    const params = new URLSearchParams({
      media_type: mediaType,
      media_id: String(mediaId),
    });
    const res = await fetchUserAPI(
      `/users/me/watchlist/check?${params}`,
      sessionCookie
    );
    if (res.ok) {
      const data = (await res.json()) as {
        exists: boolean;
        item?: { id: string; status: string };
      };
      inWatchlist = data.exists;
      if (data.item) watchlistItemId = data.item.id;
    }
  }

  const watchParams = new URLSearchParams({
    media_type: mediaType,
    media_id: String(mediaId),
    limit: '1',
  });
  if (seriesId) watchParams.set('series_id', String(seriesId));
  const watchRes = await fetchUserAPI(
    `/users/me/watch-events?${watchParams}`,
    sessionCookie
  );
  if (watchRes.ok) {
    const data = (await watchRes.json()) as {
      events: { id: string }[];
      total: number;
    };
    hasWatched = data.total > 0;
    if (data.events?.length > 0) watchEventId = data.events[0].id;
  }
}
---

{
  user ? (
    <div
      class="inline-flex"
      data-media-toolbar
      data-media-type={mediaType}
      data-media-id={String(mediaId)}
      data-series-id={seriesId ? String(seriesId) : ''}
      data-season-number={seasonNumber != null ? String(seasonNumber) : ''}
      data-episode-number={episodeNumber != null ? String(episodeNumber) : ''}
      data-watchlist-item-id={watchlistItemId ?? ''}
      data-in-watchlist={String(inWatchlist)}
      data-watch-event-id={watchEventId ?? ''}
      data-has-watched={String(hasWatched)}
    >
      <ButtonGroup>
        {showWatchlist && (
          <>
            <Button
              variant="outline"
              size="icon"
              class="h-11 w-11"
              aria-label={
                inWatchlist ? 'Remove from watchlist' : 'Add to watchlist'
              }
              title={inWatchlist ? 'Remove from watchlist' : 'Add to watchlist'}
              data-watchlist-toggle
            >
              <span hidden={!inWatchlist} data-icon-bookmark-filled>
                <IconBookmarkFilled class="size-5! text-amber-500" />
              </span>
              <span hidden={inWatchlist} data-icon-bookmark>
                <IconBookmark class="size-5!" />
              </span>
            </Button>
            <ButtonGroupSeparator />
          </>
        )}
        <span data-unwatch-container hidden={!hasWatched}>
          <Button
            variant="outline"
            size="icon"
            class={`h-11 w-11 bg-emerald-500/10 border-emerald-500/30 text-emerald-600${showWatchlist ? ' rounded-l-none border-l-0' : ''}`}
            aria-label="Unmark as watched"
            title="Unmark as watched"
            data-unwatch-btn
          >
            <IconEyeCheck class="size-5!" />
          </Button>
        </span>
        <span data-watch-container hidden={hasWatched}>
          <Button
            variant="outline"
            size="icon"
            class={`h-11 w-11${showWatchlist ? ' rounded-l-none border-l-0' : ''}`}
            aria-label="Mark as watched"
            title="Mark as watched"
            data-just-watched
          >
            <IconEye class="size-5!" />
          </Button>
        </span>
      </ButtonGroup>
    </div>
  ) : (
    <Button
      href="/login"
      variant="outline"
      size="sm"
      class="gap-1.5"
      title="Sign in to track movies and shows"
    >
      <IconBookmark class="size-5!" />
      Sign in to track
    </Button>
  )
}

<script>
  import type { CreateWatchEventResponse } from '@/pages/api/watch-events/index';
  import { toast } from '@components/starwind/toast/toast-manager';
  import { checkAndShowAchievementToast } from '@lib/achievement-toast';

  function getToolbar(e: Event): HTMLElement | null {
    return (e.target as HTMLElement).closest<HTMLElement>(
      '[data-media-toolbar]'
    );
  }

  function setWatchlistUI(toolbar: HTMLElement, added: boolean): void {
    const btn = toolbar.querySelector<HTMLElement>('[data-watchlist-toggle]');
    if (!btn) return;
    const filledIcon = btn.querySelector<HTMLElement>(
      '[data-icon-bookmark-filled]'
    );
    const outlineIcon = btn.querySelector<HTMLElement>('[data-icon-bookmark]');
    if (filledIcon) filledIcon.hidden = !added;
    if (outlineIcon) outlineIcon.hidden = added;
    const label = added ? 'Remove from watchlist' : 'Add to watchlist';
    btn.setAttribute('aria-label', label);
    btn.setAttribute('title', label);
  }

  function setWatchedUI(toolbar: HTMLElement, watched: boolean): void {
    const unwatchContainer = toolbar.querySelector<HTMLElement>(
      '[data-unwatch-container]'
    );
    const watchContainer = toolbar.querySelector<HTMLElement>(
      '[data-watch-container]'
    );
    if (unwatchContainer) unwatchContainer.hidden = !watched;
    if (watchContainer) watchContainer.hidden = watched;
  }

  async function handleWatchlistToggle(toolbar: HTMLElement): Promise<void> {
    const inWatchlist = toolbar.dataset.inWatchlist === 'true';
    if (inWatchlist) {
      const itemId = toolbar.dataset.watchlistItemId;
      if (!itemId) return;
      const res = await fetch(`/api/watchlist/${itemId}`, { method: 'DELETE' });
      if (res.ok) {
        toolbar.dataset.inWatchlist = 'false';
        toolbar.dataset.watchlistItemId = '';
        setWatchlistUI(toolbar, false);
        toast.success('Removed from watchlist');
      } else {
        toast.error('Failed to remove from watchlist');
      }
    } else {
      const mediaType = toolbar.dataset.mediaType!;
      const seriesId = toolbar.dataset.seriesId;
      const res = await fetch('/api/watchlist', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          mediaType:
            mediaType === 'episode' || mediaType === 'season'
              ? 'series'
              : mediaType,
          mediaId: Number(seriesId || toolbar.dataset.mediaId),
          status: 'want_to_watch',
        }),
      });
      if (res.ok) {
        const data = await res.json();
        toolbar.dataset.inWatchlist = 'true';
        toolbar.dataset.watchlistItemId = data.id;
        setWatchlistUI(toolbar, true);
        toast.success('Added to watchlist');
      } else {
        toast.error('Failed to add to watchlist');
      }
    }
  }

  async function handleUnwatch(toolbar: HTMLElement): Promise<void> {
    const eventId = toolbar.dataset.watchEventId;
    if (!eventId) return;
    const res = await fetch(`/api/watch-events/${eventId}`, {
      method: 'DELETE',
    });
    if (res.ok) {
      toolbar.dataset.hasWatched = 'false';
      toolbar.dataset.watchEventId = '';
      setWatchedUI(toolbar, false);
      toast.success('Removed from watch history');
    } else {
      toast.error('Failed to remove from watch history');
    }
  }

  async function handleRecordWatch(toolbar: HTMLElement): Promise<void> {
    const payload: Record<string, unknown> = {
      mediaType: toolbar.dataset.mediaType,
      mediaId: Number(toolbar.dataset.mediaId),
      justWatched: true,
    };
    const seriesId = toolbar.dataset.seriesId;
    const seasonNumber = toolbar.dataset.seasonNumber;
    const episodeNumber = toolbar.dataset.episodeNumber;
    if (seriesId) payload.seriesId = Number(seriesId);
    if (seasonNumber) payload.seasonNumber = Number(seasonNumber);
    if (episodeNumber) payload.episodeNumber = Number(episodeNumber);
    payload.timezone = Intl.DateTimeFormat().resolvedOptions().timeZone;

    const res = await fetch('/api/watch-events', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(payload),
    });
    if (res.ok) {
      const data = (await res.json()) as CreateWatchEventResponse;
      toolbar.dataset.watchEventId = data.id;
      toolbar.dataset.hasWatched = 'true';
      setWatchedUI(toolbar, true);
      toast.success('Marked as watched');
      setTimeout(() => checkAndShowAchievementToast(), 1000);
    } else {
      toast.error('Failed to mark as watched');
    }
  }

  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;

    if (target.closest('[data-watchlist-toggle]')) {
      const toolbar = getToolbar(e);
      if (toolbar) handleWatchlistToggle(toolbar);
      return;
    }

    if (target.closest('[data-unwatch-btn]')) {
      const toolbar = getToolbar(e);
      if (toolbar) handleUnwatch(toolbar);
      return;
    }

    if (target.closest('[data-just-watched]')) {
      const toolbar = getToolbar(e);
      if (toolbar) handleRecordWatch(toolbar);
      return;
    }
  });
</script>
