---
import { IconStack2, IconStar } from '@components/icons';
import type { FilmCredit } from '@lib/types';
import {
  calculateAgeAtDate,
  formatAgeDisplay,
  formatRating,
  formatYear,
  getInitials,
  tmdbImageUrl,
} from '@lib/utils';

interface Props {
  credit: FilmCredit;
  mediaType: 'movie' | 'series';
  voteAverage?: number;
  personBirthday?: string;
  personDeathday?: string;
  personCurrentAge?: number;
  personId?: number;
  prefetch?: boolean;
}

const {
  credit,
  mediaType,
  voteAverage,
  personBirthday,
  personDeathday,
  personCurrentAge,
  personId,
  prefetch = false,
} = Astro.props;

const rating = formatRating(voteAverage);

const href =
  mediaType === 'movie' ? `/movies/${credit.id}` : `/series/${credit.id}`;
const year = formatYear(credit.releaseDate);
const initials = getInitials(credit.title);
const posterUrl = tmdbImageUrl(credit.posterPath, 'w342');

const ageAtRelease =
  personBirthday && credit.releaseDate
    ? calculateAgeAtDate(personBirthday, credit.releaseDate)
    : null;

const ageDisplay = formatAgeDisplay({
  ageAtRelease: ageAtRelease ?? undefined,
  currentAge: personCurrentAge,
  birthday: personBirthday,
  deathday: personDeathday,
});

const episodeCountHref =
  credit.episodeCount && mediaType === 'series' && personId
    ? `/series/${credit.id}/person/${personId}`
    : undefined;

const eps = credit.episodeCount
  ? `${credit.episodeCount} ep${credit.episodeCount !== 1 ? 's' : ''}`
  : '';
---

<div
  class="group relative flex items-center gap-3 rounded-lg border border-border bg-card transition-colors hover:bg-accent/50
         sm:flex-col sm:items-stretch sm:gap-0 sm:border-0 sm:bg-transparent sm:hover:bg-transparent"
>
  <a
    href={href}
    class="absolute inset-0 z-0"
    data-astro-prefetch={prefetch ? '' : undefined}
  >
    <span class="sr-only">{credit.title}</span>
  </a>

  <div
    class="pointer-events-none shrink-0 w-12 aspect-2/3 overflow-hidden rounded-lg bg-muted ml-3
           sm:ml-0 sm:w-auto"
  >
    {
      posterUrl ? (
        <img
          src={posterUrl}
          alt={credit.title}
          class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
          loading="lazy"
        />
      ) : (
        <div class="flex h-full w-full items-center justify-center text-sm sm:text-2xl font-semibold text-muted-foreground">
          {initials}
        </div>
      )
    }
  </div>

  <div
    class="pointer-events-none relative flex-1 min-w-0 py-2 pr-1 sm:flex-1 sm:py-0 sm:pr-0 flex flex-col gap-0.5 sm:gap-1 sm:pt-2 sm:px-0 sm:pb-1 sm:items-center sm:text-center"
  >
    <h3
      class="font-medium leading-tight line-clamp-1 sm:line-clamp-2 text-sm group-hover:text-amber-500 transition-colors"
    >
      {credit.title}
    </h3>
    <div class="flex items-center gap-2 text-xs text-muted-foreground">
      {year && <span>{year}</span>}
      {
        rating && (
          <span class="flex items-center gap-0.5 text-amber-500/80">
            <IconStar class="h-3 w-3" />
            {voteAverage?.toFixed(1)}
          </span>
        )
      }
    </div>
    {
      credit.role && (
        <p class="text-xs text-muted-foreground italic line-clamp-1">
          {credit.type === 'cast' ? `as ${credit.role}` : credit.role}
        </p>
      )
    }
    {
      eps && !episodeCountHref && (
        <p class="text-xs text-muted-foreground italic">{eps}</p>
      )
    }
    {
      ageDisplay && (
        <span class="text-xs text-muted-foreground/70">{ageDisplay}</span>
      )
    }
    {
      episodeCountHref && (
        <a
          href={episodeCountHref}
          class="pointer-events-auto relative z-10 hidden sm:inline-flex sm:self-center items-center gap-1 text-xs text-muted-foreground bg-muted rounded-md px-2 py-0.5 hover:text-amber-500 transition-colors mt-1"
        >
          <IconStack2 class="size-3" />
          {eps}
        </a>
      )
    }
  </div>

  {
    episodeCountHref && (
      <a
        href={episodeCountHref}
        class="relative z-10 shrink-0 flex items-center gap-1 text-xs text-muted-foreground bg-muted rounded-md px-2 py-1 mr-1 hover:text-amber-500 transition-colors sm:hidden"
      >
        <IconStack2 class="size-3" />
        {eps}
      </a>
    )
  }
</div>
