---
import { IconCalendar } from '@components/icons';
import { formatDate, formatEpisodeCode, tmdbImageUrl } from '@lib/utils';

interface Props {
  seriesId: number;
  seasonNumber: number;
  episodeNumber: number;
  name: string;
  stillPath?: string;
  airDate?: string;
}

const {
  seriesId,
  seasonNumber,
  episodeNumber,
  name,
  stillPath,
  airDate,
} = Astro.props;

const href = `/series/${seriesId}/seasons/${seasonNumber}/episodes/${episodeNumber}`;
const episodeCode = formatEpisodeCode(seasonNumber, episodeNumber);
const stillUrl = tmdbImageUrl(stillPath, 'w300');
---

<a
  href={href}
  class="group flex gap-4 p-3 rounded-lg border border-border bg-card hover:bg-accent/50 transition-colors"
>
  <div class="shrink-0 w-40 aspect-video overflow-hidden rounded-lg bg-muted">
    {
      stillUrl ? (
        <img
          src={stillUrl}
          alt={name}
          class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
          loading="lazy"
        />
      ) : (
        <div class="flex h-full w-full items-center justify-center text-sm font-semibold text-muted-foreground">
          {episodeCode}
        </div>
      )
    }
  </div>

  <div class="flex-1 min-w-0">
    <span class="text-xs font-medium text-muted-foreground">{episodeCode}</span>

    <h3
      class="font-medium text-base group-hover:text-amber-500 transition-colors mt-0.5"
    >
      {name}
    </h3>

    {
      airDate && (
        <div class="flex items-center gap-1 mt-1 text-sm text-muted-foreground">
          <IconCalendar class="h-3.5 w-3.5" />
          <span>{formatDate(airDate)}</span>
        </div>
      )
    }
  </div>
</a>
