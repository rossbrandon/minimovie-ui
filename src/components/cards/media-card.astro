---
import { Badge } from '@components/starwind/badge';
import { MEDIA_CONFIG, mediaHref } from '@lib/media-config';
import type { MediaType } from '@lib/types';
import { formatYear, getImageUrl, getInitials } from '@lib/utils';

interface Props {
  id: number;
  mediaType: MediaType;
  title: string;
  posterPath?: string;
  releaseDate?: string;
  overview?: string;
  showOverview?: boolean;
  knownFor?: string;
  age?: number;
  prefetch?: boolean;
  compact?: boolean;
}

const {
  id,
  mediaType,
  title,
  posterPath,
  releaseDate,
  overview,
  showOverview = false,
  knownFor,
  age,
  prefetch = false,
  compact = false,
} = Astro.props;

const { label: mediaTypeLabel, badgeVariant } = MEDIA_CONFIG[mediaType];
const href = mediaHref(mediaType, id);

const year = formatYear(releaseDate);
const initials = getInitials(title);
const posterUrl =
  mediaType === 'person'
    ? getImageUrl(posterPath, 'w185')
    : getImageUrl(posterPath, 'w342');

const isPerson = mediaType === 'person';
const ageText =
  isPerson && age !== undefined
    ? age === -1
      ? 'Deceased'
      : String(age)
    : null;
---

<a
  href={href}
  class="group relative flex flex-col overflow-hidden rounded-lg border border-border bg-card transition-colors hover:bg-accent/50"
  data-astro-prefetch={prefetch ? '' : undefined}
>
  <div class="relative aspect-2/3 overflow-hidden bg-muted">
    {
      posterUrl ? (
        <img
          src={posterUrl}
          alt={title}
          class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
          loading="lazy"
        />
      ) : (
        <div class="flex h-full w-full items-center justify-center text-2xl font-semibold text-muted-foreground">
          {initials}
        </div>
      )
    }
  </div>

  <div
    class:list={['flex flex-1 flex-col', compact ? 'gap-0.5 p-2' : 'gap-1 p-3']}
  >
    <h3
      class="font-medium leading-tight line-clamp-2 text-sm group-hover:text-amber-500 transition-colors"
    >
      {title}{
        ageText && (
          <span class="text-muted-foreground font-normal"> ({ageText})</span>
        )
      }
    </h3>
    {
      isPerson
        ? knownFor && <p class="text-xs text-muted-foreground">{knownFor}</p>
        : year && <p class="text-xs text-muted-foreground">{year}</p>
    }
    {
      showOverview && overview && (
        <p class="mt-1 text-xs text-muted-foreground line-clamp-3">
          {overview}
        </p>
      )
    }
    <div class:list={['mt-auto', compact ? '' : 'pt-2']}>
      <Badge
        variant={badgeVariant}
        size="sm"
        class="text-[10px] uppercase tracking-wider opacity-80"
      >
        {mediaTypeLabel}
      </Badge>
    </div>
  </div>
</a>
