---
import { IconMoon, IconSun } from '@components/icons';
import { Button } from '@components/starwind/button';
---

<Button
  variant="ghost"
  size="icon-sm"
  data-theme-toggle
  aria-label="Toggle theme"
>
  <IconSun class="h-5 w-5 hidden dark:block" />
  <IconMoon class="h-5 w-5 block dark:hidden" />
</Button>

<script>
  const handleToggleClick = () => {
    const element = document.documentElement;

    let currentTheme = element.getAttribute('data-theme');
    if (!currentTheme) {
      currentTheme = window.matchMedia('(prefers-color-scheme: dark)').matches
        ? 'dark'
        : 'light';
    }

    const newTheme = currentTheme === 'dark' ? 'light' : 'dark';
    element.setAttribute('data-theme', newTheme);
    localStorage.setItem('theme', newTheme);
  };

  function bindToggles(): void {
    document
      .querySelectorAll<HTMLButtonElement>('[data-theme-toggle]')
      .forEach((btn) => {
        if (btn.dataset.bound === 'true') return;
        btn.dataset.bound = 'true';
        btn.addEventListener('click', handleToggleClick);
      });
  }

  bindToggles();
  document.addEventListener('astro:after-swap', bindToggles);
</script>
