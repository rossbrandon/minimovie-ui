---
import { MediaCard } from '@components/cards';
import {
  IconAlertCircle,
  IconAlertTriangle,
  IconMovie,
  IconSearch,
} from '@components/icons';
import { Header } from '@components/layout';
import { SearchEmptyState, SearchToolbar } from '@components/search';
import {
  Pagination,
  PaginationContent,
  PaginationEllipsis,
  PaginationItem,
  PaginationLink,
  PaginationNext,
  PaginationPrevious,
} from '@components/starwind/pagination';
import { ThemeToggle } from '@components/theme';
import Layout from '@layouts/Layout.astro';
import { search, type SearchType } from '@lib/api';
import type { SearchResponse } from '@lib/types';

const query = Astro.url.searchParams.get('q') || '';
const page = parseInt(Astro.url.searchParams.get('page') || '1', 10);
const type = (Astro.url.searchParams.get('type') as SearchType) || 'all';

let results: SearchResponse = {
  page: 1,
  totalPages: 0,
  totalResults: 0,
  results: [],
};

let error: string | null = null;

if (query) {
  try {
    results = await search(query, page, type);
  } catch (e) {
    console.error('Search failed:', e);
    error = 'Failed to fetch search results. Please try again.';
  }
}

const hasResults = results.results.length > 0;
const showPagination = results.totalPages > 1;

function buildPageUrl(newPage: number): string {
  const params = new URLSearchParams();
  params.set('q', query);
  params.set('page', String(newPage));
  if (type !== 'all') params.set('type', type);
  return `/search?${params}`;
}

function getVisiblePages(
  current: number,
  total: number
): (number | 'ellipsis')[] {
  if (total <= 7) {
    return Array.from({ length: total }, (_, i) => i + 1);
  }

  if (current <= 3) {
    return [1, 2, 3, 4, 'ellipsis', total];
  }

  if (current >= total - 2) {
    return [1, 'ellipsis', total - 3, total - 2, total - 1, total];
  }

  return [1, 'ellipsis', current - 1, current, current + 1, 'ellipsis', total];
}

const visiblePages = getVisiblePages(page, results.totalPages);
---

<Layout
  title={query ? `"${query}" - Search - MiniMovie` : 'Search - MiniMovie'}
  noindex={true}
>
  <SearchToolbar
    class="sm:hidden sticky top-0 z-40"
    inputId="search-page-input"
    ariaLabel="Search MiniMovie"
    value={query}
  >
    <a
      href="/"
      slot="left"
      aria-label="Home"
      class="inline-flex shrink-0 h-9 w-9 items-center justify-center rounded-md text-amber-500 hover:bg-accent"
    >
      <IconMovie class="h-8 w-8" />
    </a>
    <ThemeToggle slot="right" />
  </SearchToolbar>

  <div class="hidden sm:block">
    <Header searchQuery={query} />
  </div>

  <main
    class:list={[
      !query
        ? 'flex-1 flex flex-col items-center justify-center px-4 py-16 pb-41'
        : 'container mx-auto px-3 py-3 sm:px-4 sm:py-8',
    ]}
  >
    <div data-search-page class="transition-opacity duration-150 w-full">
      <div role="status" aria-live="polite" class="sr-only" data-search-status>
        {hasResults && `${results.totalResults} results for ${query}`}
      </div>
      {
        !query ? (
          <SearchEmptyState icon={IconSearch} title="What are you watching">
            Enter a search term in the box above to find movies, TV series, and
            people.
          </SearchEmptyState>
        ) : error ? (
          <div class="text-center py-16">
            <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-error/10 text-error mb-4">
              <IconAlertCircle class="h-8 w-8" />
            </div>
            <h1 class="text-2xl font-semibold mb-2">Something went wrong</h1>
            <p class="text-muted-foreground">{error}</p>
          </div>
        ) : !hasResults ? (
          <SearchEmptyState icon={IconAlertTriangle} title="No results found">
            Nothing found for "
            <span class="font-medium text-foreground">{query}</span>". Try a
            different search term.
          </SearchEmptyState>
        ) : (
          <div class="space-y-3">
            <div class="flex items-center justify-between">
              <p class="text-muted-foreground sm:-mt-4">
                {`${results.totalResults} result${results.totalResults !== 1 ? 's' : ''} found`}
              </p>
            </div>

            <div class="grid grid-cols-2 sm:grid-cols-[repeat(auto-fill,minmax(180px,1fr))] gap-3 sm:gap-4">
              {results.results.map((result) => (
                <MediaCard
                  id={result.id}
                  mediaType={result.mediaType}
                  title={result.title}
                  posterPath={result.posterPath}
                  releaseDate={result.releaseDate}
                  overview={result.overview}
                  knownFor={result.knownFor}
                  age={result.age}
                  compact
                />
              ))}
            </div>

            {showPagination && (
              <Pagination class="pt-8">
                <PaginationContent>
                  {page > 1 && (
                    <PaginationItem>
                      <PaginationPrevious href={buildPageUrl(page - 1)} />
                    </PaginationItem>
                  )}

                  {visiblePages.map((p) => (
                    <PaginationItem>
                      {p === 'ellipsis' ? (
                        <PaginationEllipsis />
                      ) : (
                        <PaginationLink
                          href={buildPageUrl(p)}
                          isActive={p === page}
                        >
                          {p}
                        </PaginationLink>
                      )}
                    </PaginationItem>
                  ))}

                  {page < results.totalPages && (
                    <PaginationItem>
                      <PaginationNext href={buildPageUrl(page + 1)} />
                    </PaginationItem>
                  )}
                </PaginationContent>
              </Pagination>
            )}
          </div>
        )
      }
    </div>
  </main>
</Layout>

<script>
  import { mountClientSearch } from '@components/search/client-search';

  function initMobileToolbar(): void {
    const input =
      document.querySelector<HTMLInputElement>('#search-page-input');
    if (!input || input.dataset.bound === 'true') return;
    input.dataset.bound = 'true';

    mountClientSearch(input);

    // form > toolbar div: walk up two levels from the input to find the
    // SearchToolbar's clear button without leaking out to other toolbars.
    const toolbar = input.parentElement?.parentElement;
    const clear = toolbar?.querySelector<HTMLButtonElement>(
      '[data-search-clear]'
    );

    function toggleClear(): void {
      if (!clear || !input) return;
      const hasValue = input.value.length > 0;
      clear.classList.toggle('hidden', !hasValue);
      clear.classList.toggle('inline-flex', hasValue);
    }

    input.addEventListener('input', toggleClear);
    toggleClear();

    clear?.addEventListener('click', () => {
      input.value = '';
      input.dispatchEvent(new Event('input', { bubbles: true }));
      toggleClear();
      input.focus();
    });
  }

  initMobileToolbar();
  document.addEventListener('astro:after-swap', initMobileToolbar);
</script>
