---
import { BrandMark } from '@components/layout';
import { SearchBox } from '@components/search';
import { ThemeToggle } from '@components/theme';
import { AuthButton } from '@components/user';
import Layout from '@layouts/Layout.astro';
import { buildWebSiteSchema } from '@lib/schema';
---

<Layout title="MiniMovie" jsonLd={buildWebSiteSchema()}>
  <div class="min-h-screen flex flex-col" data-hero-root>
    <header class="absolute top-4 right-4 z-10 flex items-center gap-2">
      <ThemeToggle />
      <AuthButton />
    </header>

    <main
      class="flex-1 flex flex-col items-center justify-center px-4 py-16 pb-72"
    >
      <div class="w-full max-w-2xl mx-auto text-center space-y-8">
        <BrandMark as="h1" />

        <div class="w-full max-w-xl mx-auto">
          <SearchBox
            variant="hero"
            placeholder="What are you watching?"
            autofocus
          />
        </div>
      </div>
    </main>
  </div>
</Layout>
