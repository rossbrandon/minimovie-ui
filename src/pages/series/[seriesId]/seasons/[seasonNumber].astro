---
import { EpisodeCard } from '@components/cards';
import {
  IconCalendar,
  IconStar,
  IconUsers,
  IconVideo,
} from '@components/icons';
import { Breadcrumbs, Header } from '@components/layout';
import NotFound from '@components/not-found.astro';
import {
  FullCastCrew,
  KeyCrew,
  QuickWatchInfo,
  TopCast,
  WhereToWatch,
} from '@components/sections';
import {
  Tabs,
  TabsContent,
  TabsList,
  TabsTrigger,
} from '@components/starwind/tabs';
import { MediaActions } from '@components/user';
import Layout from '@layouts/Layout.astro';
import { getSeason, getSeries } from '@lib/api';
import { buildBreadcrumbSchema, buildSeasonSchema } from '@lib/schema';
import type { SeasonDetails, SeriesDetails } from '@lib/types';
import {
  formatDate,
  formatRating,
  formatYearsAgo,
  getImageUrl,
} from '@lib/utils';

import IconPlayerPlay from '@tabler/icons/outline/player-play.svg';

const { seriesId, seasonNumber } = Astro.params;

let season: SeasonDetails | null = null;
let series: SeriesDetails | null = null;
let error: string | null = null;

try {
  [season, series] = await Promise.all([
    getSeason(Number(seriesId), Number(seasonNumber)),
    getSeries(Number(seriesId)),
  ]);
} catch (e) {
  console.error('Failed to fetch season:', e);
  error = 'Failed to load season details.';
}

if (error || !season) {
  Astro.response.status = 404;
}

const episodes = season?.episodes || [];
const cast = season?.credits?.cast || [];
const rating = formatRating(season?.voteAverage);

const nowIso = new Date().toISOString();
const airedEpisodeCount = episodes.filter(
  (e) => !e.airDate || e.airDate <= nowIso
).length;

const keyCrewEntries = [
  { label: 'Director', person: season?.credits?.directors?.[0] },
  { label: 'Writer', person: season?.credits?.writers?.[0] },
  { label: 'Producer', person: season?.credits?.producers?.[0] },
  { label: 'Cinematographer', person: season?.credits?.cinematographers?.[0] },
];

const breadcrumbItems =
  series && season
    ? [
        { label: series.name, href: `/series/${seriesId}` },
        { label: season.name },
      ]
    : [];

const searchQuery = series?.name;

const tabValues = [
  episodes.length > 0 && 'episodes',
  cast.length > 0 && 'top-cast',
  cast.length > 0 && 'full-cast',
  season?.whereToWatch && 'where-to-watch',
].filter(Boolean) as string[];

const requestedTab = Astro.url.searchParams.get('tab');
const defaultTab =
  requestedTab && tabValues.includes(requestedTab)
    ? requestedTab
    : tabValues[0];

const jsonLd =
  season && series
    ? [
        buildSeasonSchema(season, series),
        buildBreadcrumbSchema([
          { name: series.name, url: `/series/${seriesId}` },
          { name: season.name },
        ]),
      ]
    : undefined;
---

<Layout
  title={season && series
    ? `${season.name} - ${series.name} - MiniMovie`
    : 'Season - MiniMovie'}
  description={season?.overview}
  image={getImageUrl(season?.posterPath, 'w780')}
  jsonLd={jsonLd}
>
  <Header />

  <main class="container mx-auto px-4 py-8 flex-1">
    {
      error || !season ? (
        <NotFound
          title="Season not found"
          message={error || "The season you're looking for doesn't exist."}
        />
      ) : (
        <div class="space-y-8">
          <Breadcrumbs items={breadcrumbItems} searchQuery={searchQuery} />

          {/* Hero Section */}
          <div class="flex flex-col md:flex-row gap-8">
            {/* Poster */}
            <div class="shrink-0 mx-auto md:mx-0">
              <div class="w-64 aspect-2/3 overflow-hidden rounded-lg bg-muted shadow-lg">
                {season.posterPath ? (
                  <img
                    src={getImageUrl(season.posterPath, 'w780')}
                    alt={season.name}
                    class="h-full w-full object-cover"
                    width="256"
                    height="384"
                  />
                ) : (
                  <div class="flex h-full w-full items-center justify-center text-4xl font-semibold text-muted-foreground">
                    {season.name.charAt(0)}
                  </div>
                )}
              </div>
            </div>

            {/* Info */}
            <div class="flex-1 space-y-4">
              <div class="flex items-start justify-between gap-4">
                <div>
                  {series && (
                    <p class="text-sm text-muted-foreground mb-1">
                      {series.name}
                    </p>
                  )}
                  <h1 class="text-3xl md:text-4xl font-bold">{season.name}</h1>
                </div>
                <MediaActions
                  mediaType="season"
                  mediaId={season.id}
                  seriesId={Number(seriesId)}
                  seasonNumber={season.seasonNumber}
                  seasonEpisodeCount={airedEpisodeCount}
                />
              </div>

              {/* Metadata */}
              <div class="flex flex-wrap items-center gap-x-4 gap-y-2 text-sm text-muted-foreground">
                {season.airDate && (
                  <div class="flex items-center gap-1.5">
                    <IconCalendar class="h-4 w-4" />
                    <span>{formatDate(season.airDate)}</span>
                    {formatYearsAgo(season.airDate) && (
                      <span class="text-muted-foreground/60">
                        ({formatYearsAgo(season.airDate)})
                      </span>
                    )}
                  </div>
                )}
                {episodes.length > 0 && (
                  <div class="flex items-center gap-1.5">
                    <IconVideo class="h-4 w-4" />
                    <span>{episodes.length} episodes</span>
                  </div>
                )}
                {rating && (
                  <div class="flex items-center gap-1.5 text-amber-500">
                    <IconStar class="h-4 w-4" />
                    <span>{rating}</span>
                  </div>
                )}
              </div>

              {season.whereToWatch && (
                <QuickWatchInfo whereToWatch={season.whereToWatch} />
              )}

              {/* Overview */}
              <div class="space-y-2">
                <p class="text-foreground leading-relaxed">
                  {season.overview || 'No overview available.'}
                </p>
              </div>

              <KeyCrew entries={keyCrewEntries} />
            </div>
          </div>

          <Tabs defaultValue={defaultTab}>
            <TabsList>
              {episodes.length > 0 && (
                <TabsTrigger
                  value="episodes"
                  default={defaultTab === 'episodes'}
                >
                  <IconVideo class="size-4" /> Episodes
                  <span class="text-xs text-muted-foreground">
                    {episodes.length}
                  </span>
                </TabsTrigger>
              )}
              {cast.length > 0 && (
                <TabsTrigger
                  value="top-cast"
                  default={defaultTab === 'top-cast'}
                >
                  <IconUsers class="size-4" /> Top Cast
                </TabsTrigger>
              )}
              {cast.length > 0 && (
                <TabsTrigger
                  value="full-cast"
                  default={defaultTab === 'full-cast'}
                >
                  <IconUsers class="size-4" /> Cast & Crew
                </TabsTrigger>
              )}
              {season.whereToWatch && (
                <TabsTrigger
                  value="where-to-watch"
                  default={defaultTab === 'where-to-watch'}
                >
                  <IconPlayerPlay class="size-4" /> Where to Watch
                </TabsTrigger>
              )}
            </TabsList>

            {episodes.length > 0 && (
              <TabsContent value="episodes" default={defaultTab === 'episodes'}>
                <div class="grid grid-cols-1 gap-3">
                  {episodes.map((episode) => (
                    <EpisodeCard
                      seriesId={Number(seriesId)}
                      seasonNumber={episode.seasonNumber}
                      episodeNumber={episode.episodeNumber}
                      episodeId={episode.id}
                      name={episode.name}
                      stillPath={episode.stillPath}
                      runtime={episode.runtime}
                      airDate={episode.airDate}
                      voteAverage={episode.voteAverage}
                      overview={episode.overview}
                    />
                  ))}
                </div>
              </TabsContent>
            )}

            {cast.length > 0 && (
              <TabsContent value="top-cast" default={defaultTab === 'top-cast'}>
                <TopCast cast={cast} seriesId={Number(seriesId)} />
              </TabsContent>
            )}

            {cast.length > 0 && (
              <TabsContent
                value="full-cast"
                default={defaultTab === 'full-cast'}
              >
                <FullCastCrew
                  cast={cast}
                  credits={season.credits}
                  seriesId={Number(seriesId)}
                />
              </TabsContent>
            )}

            {season.whereToWatch && (
              <TabsContent
                value="where-to-watch"
                default={defaultTab === 'where-to-watch'}
              >
                <WhereToWatch whereToWatch={season.whereToWatch} />
              </TabsContent>
            )}
          </Tabs>
        </div>
      )
    }
  </main>
</Layout>
