---
import {
  IconCalendar,
  IconClock,
  IconStar,
  IconUsers,
} from '@components/icons';
import { Breadcrumbs, Header } from '@components/layout';
import NotFound from '@components/not-found.astro';
import { FullCastCrew, KeyCrew } from '@components/sections';
import { Badge } from '@components/starwind/badge';
import { Skeleton } from '@components/starwind/skeleton';
import {
  Tabs,
  TabsContent,
  TabsList,
  TabsTrigger,
} from '@components/starwind/tabs';
import { MediaActions } from '@components/user';
import Layout from '@layouts/Layout.astro';
import { getEpisode, getSeries } from '@lib/api';
import { buildBreadcrumbSchema, buildEpisodeSchema } from '@lib/schema';
import type { EpisodeDetails, SeriesDetails } from '@lib/types';
import {
  formatDate,
  formatEpisodeCode,
  formatRating,
  formatRuntime,
  formatYearsAgo,
  getImageUrl,
} from '@lib/utils';

const { seriesId, seasonNumber, episodeNumber } = Astro.params;

let episode: EpisodeDetails | null = null;
let series: SeriesDetails | null = null;
let error: string | null = null;

try {
  [episode, series] = await Promise.all([
    getEpisode(Number(seriesId), Number(seasonNumber), Number(episodeNumber)),
    getSeries(Number(seriesId)),
  ]);
} catch (e) {
  console.error('Failed to fetch episode:', e);
  error = 'Failed to load episode details.';
}

if (error || !episode) {
  Astro.response.status = 404;
}

const cast = episode?.credits?.cast || [];
const rating = formatRating(episode?.voteAverage);
const episodeCode = episode
  ? formatEpisodeCode(episode.seasonNumber, episode.episodeNumber)
  : '';

const seasonName =
  series?.seasons?.find((s) => s.seasonNumber === Number(seasonNumber))?.name ||
  `Season ${seasonNumber}`;

const stillUrl = getImageUrl(episode?.stillPath, 'original');

const keyCrewEntries = [
  { label: 'Director', person: episode?.credits?.directors?.[0] },
  { label: 'Writer', person: episode?.credits?.writers?.[0] },
];

const breadcrumbItems =
  series && episode
    ? [
        { label: series.name, href: `/series/${seriesId}` },
        {
          label: seasonName,
          href: `/series/${seriesId}/seasons/${seasonNumber}`,
        },
        { label: `Episode ${episode.episodeNumber}` },
      ]
    : [];

const searchQuery = series?.name;

const tabValues = [(cast.length > 0 || episode?.credits) && 'cast-crew'].filter(
  Boolean
) as string[];

const requestedTab = Astro.url.searchParams.get('tab');
const defaultTab =
  requestedTab && tabValues.includes(requestedTab)
    ? requestedTab
    : tabValues[0];

const jsonLd =
  episode && series
    ? [
        buildEpisodeSchema(episode, series, seasonName),
        buildBreadcrumbSchema([
          { name: series.name, url: `/series/${seriesId}` },
          {
            name: seasonName,
            url: `/series/${seriesId}/seasons/${seasonNumber}`,
          },
          { name: `Episode ${episode.episodeNumber}` },
        ]),
      ]
    : undefined;
---

<Layout
  title={episode && series
    ? `${episodeCode}: ${episode.name} - ${series.name} - MiniMovie`
    : 'Episode - MiniMovie'}
  description={episode?.overview}
  image={stillUrl}
  jsonLd={jsonLd}
>
  <Header />

  <main class="container mx-auto px-4 py-8 flex-1">
    {
      error || !episode ? (
        <NotFound
          title="Episode not found"
          message={error || "The episode you're looking for doesn't exist."}
        />
      ) : (
        <div class="space-y-8">
          <Breadcrumbs items={breadcrumbItems} searchQuery={searchQuery} />

          {/* Hero Section */}
          <div class="flex flex-col md:flex-row gap-8">
            {/* Episode Still (landscape) */}
            <div class="shrink-0 w-full md:w-96">
              <div class="aspect-video overflow-hidden rounded-lg bg-muted shadow-lg">
                {stillUrl ? (
                  <img
                    src={stillUrl}
                    alt={episode.name}
                    class="h-full w-full object-cover"
                    width="384"
                    height="216"
                  />
                ) : (
                  <div class="flex h-full w-full items-center justify-center text-2xl font-semibold text-muted-foreground">
                    {episodeCode}
                  </div>
                )}
              </div>
            </div>

            {/* Info */}
            <div class="flex-1 space-y-4">
              <div>
                <div class="flex items-center gap-2 mb-2">
                  <Badge variant="outline" class="text-xs">
                    {episodeCode}
                  </Badge>
                  {rating && (
                    <div class="flex items-center gap-1 text-amber-500 text-sm">
                      <IconStar class="h-4 w-4" />
                      <span>{rating}</span>
                    </div>
                  )}
                </div>
                <div class="flex items-start justify-between gap-4">
                  <div>
                    <h1 class="text-3xl md:text-4xl font-bold">
                      {episode.name}
                    </h1>
                    {series && (
                      <p class="text-muted-foreground mt-1">{series.name}</p>
                    )}
                  </div>
                  <MediaActions
                    server:defer
                    mediaType="episode"
                    mediaId={episode.id}
                    seriesId={Number(seriesId)}
                    seasonNumber={episode.seasonNumber}
                    episodeNumber={episode.episodeNumber}
                  >
                    <Skeleton slot="fallback" class="h-9 w-12" />
                  </MediaActions>
                </div>
              </div>

              {/* Metadata */}
              <div class="flex flex-wrap items-center gap-x-4 gap-y-2 text-sm text-muted-foreground">
                {episode.airDate && (
                  <div class="flex items-center gap-1.5">
                    <IconCalendar class="h-4 w-4" />
                    <span>{formatDate(episode.airDate)}</span>
                    {formatYearsAgo(episode.airDate) && (
                      <span class="text-muted-foreground/60">
                        ({formatYearsAgo(episode.airDate)})
                      </span>
                    )}
                  </div>
                )}
                {episode.runtime && (
                  <div class="flex items-center gap-1.5">
                    <IconClock class="h-4 w-4" />
                    <span>{formatRuntime(episode.runtime)}</span>
                  </div>
                )}
              </div>

              {/* Overview */}
              <div class="space-y-2">
                <p class="text-foreground leading-relaxed">
                  {episode.overview || 'No overview available.'}
                </p>
              </div>

              <KeyCrew entries={keyCrewEntries} />
            </div>
          </div>

          <Tabs defaultValue={defaultTab}>
            <TabsList>
              {(cast.length > 0 || episode.credits) && (
                <TabsTrigger
                  value="cast-crew"
                  default={defaultTab === 'cast-crew'}
                >
                  <IconUsers class="size-4" /> Cast & Crew
                </TabsTrigger>
              )}
            </TabsList>

            {(cast.length > 0 || episode.credits) && (
              <TabsContent
                value="cast-crew"
                default={defaultTab === 'cast-crew'}
              >
                <FullCastCrew cast={cast} credits={episode.credits} />
              </TabsContent>
            )}
          </Tabs>
        </div>
      )
    }
  </main>
</Layout>
