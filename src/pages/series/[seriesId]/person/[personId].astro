---
import { EpisodeAppearanceCard } from '@components/cards';
import { IconVideo } from '@components/icons';
import { Breadcrumbs, Header } from '@components/layout';
import NotFound from '@components/not-found.astro';
import { Badge } from '@components/starwind/badge';
import {
  Tabs,
  TabsContent,
  TabsList,
  TabsTrigger,
} from '@components/starwind/tabs';
import Layout from '@layouts/Layout.astro';
import { getPersonSeriesCredits } from '@lib/api';
import type { PersonSeriesCredits } from '@lib/types';
import { getImageUrl } from '@lib/utils';

const { seriesId, personId } = Astro.params;

let data: PersonSeriesCredits | null = null;
let error: string | null = null;

try {
  data = await getPersonSeriesCredits(Number(seriesId), Number(personId));
} catch (e) {
  console.error('Failed to fetch person series credits:', e);
  error = 'Failed to load credits.';
}

if (error || !data) {
  Astro.response.status = 404;
}

const personName = data?.person.name || 'Unknown';
const seriesName = data?.series.name || 'Unknown';
const personPhoto = getImageUrl(data?.person.photoPath, 'h632');
const seriesPoster = getImageUrl(data?.series.posterPath, 'w185');
const roles = data?.roles?.map((r) => r.character).join(', ') || '';

const breadcrumbItems = data
  ? [
      { label: data.series.name, href: `/series/${seriesId}` },
      { label: data.person.name },
    ]
  : [];

const tabValues = data?.seasons.map((s) => `season-${s.seasonNumber}`) || [];
const requestedTab = Astro.url.searchParams.get('tab');
const defaultTab =
  requestedTab && tabValues.includes(requestedTab)
    ? requestedTab
    : tabValues[0];
---

<Layout
  title={data
    ? `${personName} in ${seriesName} - MiniMovie`
    : 'Credits - MiniMovie'}
  description={data
    ? `${personName} appeared in ${data.totalEpisodeCount} episodes of ${seriesName}`
    : undefined}
  image={personPhoto || seriesPoster}
>
  <Header />

  <main class="container mx-auto px-4 py-8 flex-1">
    {
      error || !data ? (
        <NotFound
          title="Credits not found"
          message={error || "The credits you're looking for don't exist."}
        />
      ) : (
        <div class="space-y-8">
          <Breadcrumbs items={breadcrumbItems} />

          {/* Hero */}
          <div class="flex flex-col md:flex-row gap-8">
            <a href={`/people/${data.person.id}`} class="shrink-0 mx-auto md:mx-0 group">
              <div class="w-40 aspect-2/3 overflow-hidden rounded-lg bg-muted shadow-lg">
                {personPhoto ? (
                  <img
                    src={personPhoto}
                    alt={personName}
                    class="h-full w-full object-cover group-hover:scale-105 transition-transform"
                    width="160"
                    height="240"
                  />
                ) : (
                  <div class="flex h-full w-full items-center justify-center text-3xl font-semibold text-muted-foreground">
                    {personName.charAt(0)}
                  </div>
                )}
              </div>
            </a>

            <div class="flex-1 space-y-3">
              <div>
                <h1 class="text-3xl md:text-4xl font-bold">
                  <a
                    href={`/people/${data.person.id}`}
                    class="hover:text-amber-500 transition-colors"
                  >
                    {personName}
                  </a>
                </h1>
                <p class="text-lg text-muted-foreground mt-1">
                  in{' '}
                  <a
                    href={`/series/${seriesId}`}
                    class="hover:text-amber-500 transition-colors"
                  >
                    {seriesName}
                  </a>
                </p>
              </div>
              {roles && <p class="text-muted-foreground">as {roles}</p>}
              <div class="flex items-center gap-2">
                <Badge variant="default">
                  <IconVideo class="size-3.5 mr-1" />
                  {data.totalEpisodeCount}{' '}
                  {data.totalEpisodeCount === 1 ? 'Episode' : 'Episodes'}
                </Badge>
              </div>
            </div>
          </div>

          {/* Season-by-season breakdown */}
          <Tabs defaultValue={defaultTab}>
            <TabsList>
              {data.seasons.map((season) => {
                const value = `season-${season.seasonNumber}`;
                return (
                  <TabsTrigger value={value} default={defaultTab === value}>
                    <IconVideo class="size-4" />
                    {season.name}
                    <span class="text-xs text-muted-foreground">
                      {season.episodes.length}/{season.totalEpisodes}
                    </span>
                  </TabsTrigger>
                );
              })}
            </TabsList>

            {data.seasons.map((season) => {
              const value = `season-${season.seasonNumber}`;
              return (
                <TabsContent value={value} default={defaultTab === value}>
                  <p class="text-sm text-muted-foreground mb-4">
                    {season.episodes.length} of {season.totalEpisodes} episodes
                  </p>
                  <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-3">
                    {season.episodes.map((ep) => (
                      <EpisodeAppearanceCard
                        seriesId={Number(seriesId)}
                        seasonNumber={season.seasonNumber}
                        episodeNumber={ep.episodeNumber}
                        name={ep.name}
                        stillPath={ep.stillPath}
                        airDate={ep.airDate}
                      />
                    ))}
                  </div>
                </TabsContent>
              );
            })}
          </Tabs>
        </div>
      )
    }
  </main>
</Layout>
