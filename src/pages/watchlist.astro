---
import { WatchlistCard } from '@components/cards';
import { IconBookmark, IconSearch } from '@components/icons';
import { Header } from '@components/layout';
import { Badge } from '@components/starwind/badge';
import {
  Tabs,
  TabsContent,
  TabsList,
  TabsTrigger,
} from '@components/starwind/tabs';
import Layout from '@layouts/Layout.astro';
import { fetchUserAPI } from '@lib/api';
import { getSessionCookie } from '@lib/session';

if (!Astro.locals.user) {
  return Astro.redirect('/login');
}

const sessionCookie = getSessionCookie(Astro.cookies);
if (!sessionCookie) {
  return Astro.redirect('/login');
}

interface WatchlistItem {
  id: string;
  mediaType: 'movie' | 'series';
  mediaId: number;
  mediaTitle: string;
  posterPath: string | null;
  status: string;
  addedAt: string;
  watchCount: number;
  episodesWatched: number;
  seasonsWatched: number;
  totalEpisodes?: number | null;
  totalSeasons?: number | null;
  inProduction?: boolean | null;
  nextAirDate?: string | null;
  genres: string[];
  runtimeMinutes?: number | null;
  voteAverage?: number | null;
  releaseYear?: number | null;
}

let items: WatchlistItem[] = [];
let error = false;

try {
  const res = await fetchUserAPI('/users/me/watchlist', sessionCookie);
  if (res.ok) {
    const data = (await res.json()) as { items: WatchlistItem[] };
    items = data.items || [];
  } else {
    error = true;
  }
} catch {
  error = true;
}

const wantToWatch = items.filter((i) => i.status === 'want_to_watch');
const watched = items.filter((i) => i.status === 'watched');

const requestedTab = Astro.url.searchParams.get('tab');
const validTabs = ['all', 'want_to_watch', 'watched'];
const defaultTab =
  requestedTab && validTabs.includes(requestedTab) ? requestedTab : 'all';
---

<Layout title="Watchlist - MiniMovie" noindex>
  <Header />

  <main class="container mx-auto px-4 py-8 flex-1 max-w-6xl">
    <div class="space-y-8">
      <h1 class="text-3xl font-bold">My Watchlist</h1>

      {
        error ? (
          <p class="text-muted-foreground">
            Failed to load your watchlist. Please try again.
          </p>
        ) : items.length === 0 ? (
          <div class="text-center py-16 space-y-4">
            <IconBookmark class="h-12 w-12 text-muted-foreground mx-auto" />
            <p class="text-muted-foreground text-lg">Your watchlist is empty</p>
            <p class="text-muted-foreground text-sm">
              Search for movies and TV shows to start building your collection.
            </p>
          </div>
        ) : (
          <Tabs defaultValue={defaultTab}>
            <TabsList>
              <TabsTrigger value="all" default={defaultTab === 'all'}>
                All
                <Badge
                  variant="outline"
                  class="text-xs"
                  data-tab-badge="all"
                  data-original-count={items.length}
                >
                  {items.length}
                </Badge>
              </TabsTrigger>
              <TabsTrigger
                value="want_to_watch"
                default={defaultTab === 'want_to_watch'}
              >
                Want to Watch
                <Badge
                  variant="outline"
                  class="text-xs"
                  data-tab-badge="want_to_watch"
                  data-original-count={wantToWatch.length}
                >
                  {wantToWatch.length}
                </Badge>
              </TabsTrigger>
              <TabsTrigger value="watched" default={defaultTab === 'watched'}>
                Watched
                <Badge
                  variant="outline"
                  class="text-xs"
                  data-tab-badge="watched"
                  data-original-count={watched.length}
                >
                  {watched.length}
                </Badge>
              </TabsTrigger>
            </TabsList>

            {[
              { value: 'all', list: items, emptyText: '' },
              {
                value: 'want_to_watch',
                list: wantToWatch,
                emptyText: 'Nothing in your queue. Start exploring!',
              },
              {
                value: 'watched',
                list: watched,
                emptyText: "You haven't marked anything as watched yet.",
              },
            ].map((panel) => (
              <TabsContent
                value={panel.value}
                default={defaultTab === panel.value}
              >
                {panel.list.length === 0 && panel.emptyText ? (
                  <div class="text-center py-12">
                    <p class="text-muted-foreground">{panel.emptyText}</p>
                  </div>
                ) : (
                  <>
                    <div class="flex flex-wrap items-center gap-3 mb-6">
                      <div class="relative max-w-sm flex-1">
                        <IconSearch class="absolute left-3 top-1/2 -translate-y-1/2 h-4 w-4 text-muted-foreground pointer-events-none" />
                        <input
                          type="text"
                          placeholder="Filter by title..."
                          class="w-full h-9 rounded-md border border-input bg-background px-9 text-sm placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring"
                          data-watchlist-search
                        />
                      </div>
                      <select
                        data-watchlist-type-filter
                        class="h-9 rounded-md border border-input bg-background pl-3 pr-8 text-sm focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring"
                        aria-label="Filter by type"
                      >
                        <option value="all">All types</option>
                        <option value="movie">Movies</option>
                        <option value="series">TV</option>
                      </select>
                    </div>
                    <div
                      class="grid grid-cols-1 md:grid-cols-2 gap-3"
                      data-watchlist-grid
                      data-tab-value={panel.value}
                    >
                      {panel.list.map((item) => (
                        <WatchlistCard item={item} />
                      ))}
                    </div>
                    <p
                      class="text-sm text-muted-foreground text-center hidden mt-6"
                      data-watchlist-no-results
                    >
                      No items match your filters.
                    </p>
                  </>
                )}
              </TabsContent>
            ))}
          </Tabs>
        )
      }
    </div>
  </main>
</Layout>

<script>
  // Coordinates the title-search input and the media-type select inside each
  // TabsContent panel. After every filter change we recompute the visible
  // card count for the panel and write it back to the matching tab badge so
  // the count never lies when filters are active.
  function bindWatchlistFilters(): void {
    document
      .querySelectorAll<HTMLElement>('[data-tabs-content]')
      .forEach((panel) => {
        const input = panel.querySelector<HTMLInputElement>(
          '[data-watchlist-search]'
        );
        const typeSelect = panel.querySelector<HTMLSelectElement>(
          '[data-watchlist-type-filter]'
        );
        const grid = panel.querySelector<HTMLElement>('[data-watchlist-grid]');
        const noResults = panel.querySelector<HTMLElement>(
          '[data-watchlist-no-results]'
        );
        if (!grid) {
          return;
        }

        const tabValue = grid.dataset.tabValue;
        const badge = tabValue
          ? document.querySelector<HTMLElement>(
              `[data-tab-badge="${tabValue}"]`
            )
          : null;

        function applyFilters(): void {
          const query = (input?.value ?? '').toLowerCase().trim();
          const type = typeSelect?.value ?? 'all';
          const cards = grid!.querySelectorAll<HTMLElement>('[data-title]');
          let visible = 0;

          cards.forEach((card) => {
            const titleMatch =
              !query || (card.dataset.title ?? '').includes(query);
            const typeMatch = type === 'all' || card.dataset.mediaType === type;
            const match = titleMatch && typeMatch;
            card.style.display = match ? '' : 'none';
            if (match) {
              visible += 1;
            }
          });

          if (noResults) {
            noResults.classList.toggle('hidden', visible > 0);
          }
          if (badge) {
            badge.textContent = String(visible);
          }
        }

        input?.addEventListener('input', applyFilters);
        typeSelect?.addEventListener('change', applyFilters);
      });
  }

  bindWatchlistFilters();
  document.addEventListener('astro:after-swap', bindWatchlistFilters);
</script>
