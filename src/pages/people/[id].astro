---
import { CreditCard } from '@components/cards';
import {
  IconCake,
  IconDeviceTv,
  IconInfoCircle,
  IconMapPin,
  IconMovie,
  IconStar,
  IconUser,
} from '@components/icons';
import { Header } from '@components/layout';
import NotFound from '@components/not-found.astro';
import { InterestingInfo, SectionSearch } from '@components/sections';
import { Skeleton } from '@components/starwind/skeleton';
import {
  Tabs,
  TabsContent,
  TabsList,
  TabsTrigger,
} from '@components/starwind/tabs';
import Layout from '@layouts/Layout.astro';
import { getPerson } from '@lib/api';
import { buildPersonSchema } from '@lib/schema';
import type { FilmCredit, PersonDetails } from '@lib/types';
import {
  formatPersonAge,
  getImageUrl,
  getInitials,
  truncateText,
} from '@lib/utils';

const { id } = Astro.params;

let person: PersonDetails | null = null;
let error: string | null = null;

try {
  person = await getPerson(Number(id));
} catch (e) {
  console.error('Failed to fetch person:', e);
  error = 'Failed to load person details.';
}

if (error || !person) {
  Astro.response.status = 404;
}

const movieCredits = person?.movieCredits || [];
const seriesCredits = person?.seriesCredits || [];

const sortByDate = (a: FilmCredit, b: FilmCredit) => {
  if (!a.releaseDate && !b.releaseDate) return 0;
  if (!a.releaseDate) return 1;
  if (!b.releaseDate) return -1;
  return new Date(b.releaseDate).getTime() - new Date(a.releaseDate).getTime();
};

const knownForScore = (credit: FilmCredit, isTV: boolean): number => {
  if (credit.role?.match(/^Self/i)) return -Infinity;

  const audienceReach = Math.log10(Math.max(credit.voteCount ?? 1, 1));

  let roleSignificance: number;
  if (isTV) {
    roleSignificance = Math.log2(1 + (credit.episodeCount ?? 0)) / 6;
  } else {
    roleSignificance =
      credit.order != null ? 1 / (1 + credit.order * 0.1) : 0.1;
  }

  const quality = 0.5 + (credit.voteAverage ?? 5) / 20;

  return audienceReach * Math.min(roleSignificance, 1) * quality;
};

const sortedMovieCredits = [...movieCredits].sort(sortByDate);
const sortedSeriesCredits = [...seriesCredits].sort(sortByDate);

const knownFor = [...movieCredits, ...seriesCredits]
  .map((c) => ({
    credit: c,
    score: knownForScore(c, seriesCredits.includes(c)),
  }))
  .sort((a, b) => b.score - a.score)
  .slice(0, 16)
  .map((x) => x.credit);

const maxPopularity = Math.max(
  0,
  ...movieCredits.map((c) => c.popularity ?? 0),
  ...seriesCredits.map((c) => c.popularity ?? 0)
);
const isNotable = maxPopularity >= 1.0;

const ageInfo = person
  ? formatPersonAge(person.birthday, person.deathday, person.currentAge)
  : null;

const photoUrl = getImageUrl(person?.photoPath, 'h632');

const tabValues = [
  knownFor.length > 0 && 'known-for',
  sortedMovieCredits.length > 0 && 'movies',
  sortedSeriesCredits.length > 0 && 'series',
  'interesting-info',
].filter(Boolean) as string[];

const requestedTab = Astro.url.searchParams.get('tab');
const defaultTab =
  requestedTab && tabValues.includes(requestedTab)
    ? requestedTab
    : tabValues[0];

const jsonLd = person ? buildPersonSchema(person) : undefined;
---

<Layout
  title={person ? `${person.name} - MiniMovie` : 'Person - MiniMovie'}
  description={person ? truncateText(person.biography || '', 160) : undefined}
  image={photoUrl}
  jsonLd={jsonLd}
>
  <Header />

  <main class="container mx-auto px-4 py-8 flex-1">
    {
      error || !person ? (
        <NotFound
          title="Person not found"
          message={error || "The person you're looking for doesn't exist."}
        />
      ) : (
        <div class="space-y-8">
          {/* Hero Section */}
          <div class="flex flex-col md:flex-row gap-8">
            {/* Photo */}
            <div class="shrink-0 mx-auto md:mx-0">
              <div class="w-64 aspect-2/3 overflow-hidden rounded-lg bg-muted shadow-lg">
                {photoUrl ? (
                  <img
                    src={photoUrl}
                    alt={person.name}
                    class="h-full w-full object-cover"
                    width="256"
                    height="384"
                  />
                ) : (
                  <div class="flex h-full w-full items-center justify-center text-4xl font-semibold text-muted-foreground">
                    {getInitials(person.name)}
                  </div>
                )}
              </div>
            </div>

            {/* Info */}
            <div class="flex-1 space-y-4">
              <div>
                <h1 class="text-3xl md:text-4xl font-bold">{person.name}</h1>
                {person.knownFor && (
                  <p class="text-lg text-muted-foreground mt-1">
                    {person.knownFor}
                  </p>
                )}
              </div>

              {/* Personal Details */}
              <div class="flex flex-wrap items-center gap-x-4 gap-y-2 text-sm text-muted-foreground">
                {ageInfo && (
                  <div class="flex items-center gap-1.5">
                    <IconCake class="h-4 w-4" />
                    <span>{ageInfo}</span>
                  </div>
                )}
                {person.placeOfBirth && (
                  <div class="flex items-center gap-1.5">
                    <IconMapPin class="h-4 w-4" />
                    <span>{person.placeOfBirth}</span>
                  </div>
                )}
                {person.gender && person.gender !== 'Not specified' && (
                  <div class="flex items-center gap-1.5">
                    <IconUser class="h-4 w-4" />
                    <span>{person.gender}</span>
                  </div>
                )}
              </div>
              <div class="flex flex-wrap items-center gap-x-4 gap-y-2 text-sm text-muted-foreground">
                {movieCredits.length > 0 && (
                  <div class="flex items-center gap-1.5">
                    <IconMovie class="h-4 w-4" />
                    <span>{movieCredits.length} Movies</span>
                  </div>
                )}
                {seriesCredits.length > 0 && (
                  <div class="flex items-center gap-1.5">
                    <IconDeviceTv class="h-4 w-4" />
                    <span>{seriesCredits.length} TV Shows</span>
                  </div>
                )}
              </div>

              {/* Biography */}
              {person.biography && (
                <div class="space-y-2">
                  <p class="text-foreground leading-relaxed whitespace-pre-line">
                    {person.biography}
                  </p>
                </div>
              )}
            </div>
          </div>

          <Tabs defaultValue={defaultTab}>
            <TabsList>
              {knownFor.length > 0 && (
                <TabsTrigger
                  value="known-for"
                  default={defaultTab === 'known-for'}
                >
                  <IconStar class="size-4" /> Known For
                </TabsTrigger>
              )}
              {sortedMovieCredits.length > 0 && (
                <TabsTrigger value="movies" default={defaultTab === 'movies'}>
                  <IconMovie class="size-4" /> Movies
                  <span class="text-xs leading-none translate-y-px text-muted-foreground">
                    {sortedMovieCredits.length}
                  </span>
                </TabsTrigger>
              )}
              {sortedSeriesCredits.length > 0 && (
                <TabsTrigger value="series" default={defaultTab === 'series'}>
                  <IconDeviceTv class="size-4" /> TV Series
                  <span class="text-xs leading-none translate-y-px text-muted-foreground">
                    {sortedSeriesCredits.length}
                  </span>
                </TabsTrigger>
              )}
              <TabsTrigger
                value="interesting-info"
                default={defaultTab === 'interesting-info'}
              >
                <IconInfoCircle class="size-4" /> Interesting Info
              </TabsTrigger>
            </TabsList>

            {knownFor.length > 0 && (
              <TabsContent
                value="known-for"
                default={defaultTab === 'known-for'}
              >
                <div class="grid grid-cols-1 sm:grid-cols-[repeat(auto-fill,minmax(140px,1fr))] gap-3 sm:gap-4">
                  {knownFor.map((credit) => (
                    <CreditCard
                      credit={credit}
                      mediaType={
                        movieCredits.includes(credit) ? 'movie' : 'series'
                      }
                      voteAverage={credit.voteAverage}
                      personBirthday={person.birthday}
                      personDeathday={person.deathday}
                      personCurrentAge={person.currentAge}
                      personId={person.id}
                      prefetch={true}
                    />
                  ))}
                </div>
              </TabsContent>
            )}

            {sortedMovieCredits.length > 0 && (
              <TabsContent value="movies" default={defaultTab === 'movies'}>
                <div class="space-y-4">
                  <SectionSearch placeholder="Search movies..." />
                  <div class="section-search-grid grid grid-cols-1 sm:grid-cols-[repeat(auto-fill,minmax(140px,1fr))] gap-3 sm:gap-4">
                    {sortedMovieCredits.map((credit) => (
                      <CreditCard
                        credit={credit}
                        mediaType="movie"
                        voteAverage={credit.voteAverage}
                        personBirthday={person.birthday}
                        personDeathday={person.deathday}
                        personCurrentAge={person.currentAge}
                      />
                    ))}
                  </div>
                </div>
              </TabsContent>
            )}

            {sortedSeriesCredits.length > 0 && (
              <TabsContent value="series" default={defaultTab === 'series'}>
                <div class="space-y-4">
                  <SectionSearch placeholder="Search series..." />
                  <div class="section-search-grid grid grid-cols-1 sm:grid-cols-[repeat(auto-fill,minmax(140px,1fr))] gap-3 sm:gap-4">
                    {sortedSeriesCredits.map((credit) => (
                      <CreditCard
                        credit={credit}
                        mediaType="series"
                        voteAverage={credit.voteAverage}
                        personBirthday={person.birthday}
                        personDeathday={person.deathday}
                        personCurrentAge={person.currentAge}
                        personId={person.id}
                      />
                    ))}
                  </div>
                </div>
              </TabsContent>
            )}

            <TabsContent
              value="interesting-info"
              default={defaultTab === 'interesting-info'}
            >
              <div class="space-y-6 px-1">
                {isNotable && (
                  <InterestingInfo
                    server:defer
                    personId={person.id}
                    personName={person.name}
                  >
                    <div
                      slot="fallback"
                      id="interesting-info-fallback"
                      class="space-y-3"
                    >
                      <p class="text-xs text-muted-foreground">
                        Gathering insights...
                      </p>
                      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <Skeleton class="h-10 w-full" />
                        <Skeleton class="h-10 w-full" />
                        <Skeleton class="h-10 w-full" />
                        <Skeleton class="h-10 w-full" />
                        <Skeleton class="h-10 w-full" />
                      </div>
                    </div>
                  </InterestingInfo>
                )}

                <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-sm">
                  {person.alsoKnownAs && person.alsoKnownAs.length > 0 && (
                    <div class="md:col-span-2">
                      <p class="text-muted-foreground">Also Known As</p>
                      <p class="font-medium">{person.alsoKnownAs.join(', ')}</p>
                    </div>
                  )}
                  {person.imdbId && (
                    <div>
                      <p class="text-muted-foreground">IMDB</p>
                      <a
                        href={`https://www.imdb.com/name/${person.imdbId}`}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="font-medium text-muted-foreground hover:underline"
                      >
                        {person.imdbId}
                      </a>
                    </div>
                  )}
                </div>
              </div>
            </TabsContent>
          </Tabs>
        </div>
      )
    }
  </main>
</Layout>
