{
  "name": "minimovie-ui",
  "type": "module",
  "version": "1.0.0",
  "scripts": {
    "dev": "astro dev --site http://localhost:4321",
    "host": "astro dev --host --site http://localhost:4321",
    "build": "astro build",
    "preview": "rm -rf .wrangler/state && rm -rf dist/ && astro build --site http://localhost:4321 && astro preview",
    "astro": "astro",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "engines": {
    "node": ">=24.14.0"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^13.1.7",
    "@astrojs/solid-js": "^6.0.1",
    "@kobalte/core": "^0.13.11",
    "@tabler/icons": "^3.41.1",
    "@tabler/icons-solidjs": "^3.41.1",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/vite": "^4.2.2",
    "astro": "^6.1.3",
    "focus-trap": "^8.0.1",
    "solid-js": "^1.9.12",
    "tailwind-merge": "^3.5.0",
    "tailwind-variants": "^3.2.2",
    "tailwindcss": "^4.2.2",
    "tw-animate-css": "^1.4.0",
    "wrangler": "^4.80.0"
  },
  "devDependencies": {
    "@typescript-eslint/parser": "^8.58.0",
    "eslint": "^10.2.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^1.6.0",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "prettier": "^3.8.1",
    "prettier-plugin-astro": "^0.14.1"
